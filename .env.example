# Copie para .env (local) e configure as mesmas variáveis na Vercel.
# NUNCA comite o .env real — ele está no .gitignore.

# ===== Stripe =====
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs (produtos já criados na conta):
STRIPE_PRICE_READINGS_PACK=price_1Tvg2V07YF1LaBzhBH3h9Tqm     # Pacote 5 Leituras — US$ 9,99 (avulso)
STRIPE_PRICE_PREMIUM_MONTHLY=price_1U4Vqh07YF1LaBzhq5nVOypv   # Premium Ilimitado - US$ 14,99/mes
STRIPE_PRICE_PREMIUM_YEARLY=price_1U4Vqh07YF1LaBzh0vT7RR7w    # Premium Anual - US$ 79/ano

# ===== AstrologyAPI.com (só no servidor) =====
ASTROLOGY_API_BASE_URL=https://json.astrologyapi.com/v1
# Chave nova (formato ak-...) autentica via header x-astrologyapi-key.
ASTROLOGY_API_KEY=ak-...

# ===== Clerk (autenticação) =====
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/register
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# ===== Groq (IA / interpretações pt-BR) =====
GROQ_API_KEY=gsk_...

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...
# service_role (Settings > API). OBRIGATÓRIA para webhook e controle de leituras.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...

# ===== App =====
NEXT_PUBLIC_APP_URL=https://seudominio.com
NODE_ENV=production

# ===== Analytics (opcional, mas necessário para medir o funil) =====
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-L2146BNFT1
NEXT_PUBLIC_META_PIXEL_ID=

# ===== VSL =====
# Vídeo hospedado no Cloudflare R2 (não vai no repositório).
NEXT_PUBLIC_VSL_URL=https://pub-94956eceb3c048a7a62f1ebc80da35ec.r2.dev/vsl%202.0%20-%20AstroTarot%20APP%20-%20comprimido.mp4

# ===== Admin =====
# E-mails com acesso ao painel /admin/affiliates (separados por vírgula).
ADMIN_EMAILS=

# ===== Pexels (stock images) =====
PEXELS_API_KEY=your_pexels_key
STRIPE_PRICE_SOULMATE_PORTRAIT=price_1U4Vra07YF1LaBzhrWLpDzEk # Draw Your Soulmate - US$ 24,99 (avulso)
STRIPE_PRICE_VIBES_MONTHLY=price_1U4Vrb07YF1LaBzhbDjdir7l     # Vibes & Meditations - US$ 9,99/mes
GEMINI_API_KEY=                                               # Geracao do retrato (Gemini image / "nano banana")

# ===== E-mail (Resend) =====
# Chave em resend.com/api-keys. Sem ela, nenhum e-mail e enviado
# (o funil continua funcionando normalmente).
RESEND_API_KEY=re_...
# Remetente: precisa ser de um dominio VERIFICADO no Resend.
EMAIL_FROM=AstroTarot <hello@astrotarot.shop>
# Segredo do cron de carrinho abandonado (POST /api/email/recover).
CRON_SECRET=